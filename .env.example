# Copy to .env and replace before running docker compose.
# Never commit the resulting .env file.
# Legacy single credential (still supported):
MCP_API_KEY=replace-with-a-random-value-at-least-32-characters
# Optional comma-separated stable credentials for identity-attributable validation:
# MCP_API_KEYS=replace-key-a-at-least-32-characters,replace-key-b-at-least-32-characters,replace-key-c-at-least-32-characters
MCP_ALLOWED_SERVERS=github

# Trust X-Forwarded-For only when the socket peer belongs to one of these
# operator-controlled proxy/load-balancer networks. Otherwise the socket peer
# address is authoritative.
# MCP_TRUSTED_PROXY_CIDRS=10.0.0.0/8,2001:db8:100::/48

# Optional local Cerberus validation queue. Raw credentials and raw IPs are
# never written here; only the twelve-field fingerprinted event is emitted.
# MCP_CERBERUS_ENABLED=true
# MCP_CERBERUS_TENANT_SALT=replace-with-customer-held-tenant-salt
# MCP_CERBERUS_OUTPUT=/var/lib/mcp-monitor/cerberus-events.ndjson
# MCP_CERBERUS_SCHEMA_VERSION=1
# MCP_CERBERUS_CLIENT=mcp-agent-security-gateway

# Optional alert destination:
# MCP_WEBHOOK_URL=https://alerts.example.internal/mcp

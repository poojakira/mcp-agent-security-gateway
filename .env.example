# Copy to .env and replace before running docker compose.
# Never commit the resulting .env file.

# Authentication.
# Configure either the legacy single credential or a stable multi-credential set.
# For the Cerberus baseline, use one fixed three-credential MCP_API_KEYS value and
# keep it unchanged across restarts. Do not regenerate it per validation run.
MCP_API_KEY=
# MCP_API_KEYS=replace-key-a-at-least-32-characters,replace-key-b-at-least-32-characters,replace-key-c-at-least-32-characters
MCP_ALLOWED_SERVERS=github

# Trust X-Forwarded-For only when the socket peer belongs to one of these
# operator-controlled proxy/load-balancer networks. Otherwise the socket peer
# address is authoritative.
# MCP_TRUSTED_PROXY_CIDRS=10.0.0.0/8,2001:db8:100::/48

# Optional identity/network validation queue and durable live delivery.
# Raw credentials and raw IPs are never written to the queue. Each line is an
# immutable transport envelope with event_fps for retry deduplication.
# For baseline collection, keep the tenant salt stable for the entire baseline.
# MCP_IDENTITY_TELEMETRY_ENABLED=true
# MCP_IDENTITY_TELEMETRY_TENANT_SALT=replace-with-customer-held-tenant-salt
# MCP_IDENTITY_TELEMETRY_ENDPOINT=https://validation.example/v1/events
# MCP_IDENTITY_TELEMETRY_BEARER_TOKEN=replace-with-runtime-secret
# MCP_IDENTITY_TELEMETRY_POLL_SECONDS=2
# MCP_IDENTITY_TELEMETRY_MAX_BACKOFF_SECONDS=60

# Start continuous delivery only when the above values are configured:
# docker compose --profile identity-telemetry up -d --build

# Optional alert destination:
# MCP_WEBHOOK_URL=https://alerts.example.internal/mcp

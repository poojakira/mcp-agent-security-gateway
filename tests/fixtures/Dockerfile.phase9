# Disposable, stdlib-only networking fixtures. Not a production server.
FROM public.ecr.aws/docker/library/python:3.12-alpine
COPY --chmod=0555 tests/fixtures/phase9_network_server.py /opt/phase9/mcp.py
COPY --chmod=0555 tests/fixtures/phase9_sidecar_fixture.py /opt/phase9/sidecar.py
USER 65534:65534
WORKDIR /tmp
